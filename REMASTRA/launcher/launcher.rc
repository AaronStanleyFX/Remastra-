#include <windows.h>

1 ICON "../remastra/assets/icon.ico"
1 24 "remastra.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,5,5,0
PRODUCTVERSION  1,5,5,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName",      "REMASTRA"
      VALUE "FileDescription",  "REMASTRA - AI Audio Remaster Studio"
      VALUE "FileVersion",      "1.5.5"
      VALUE "InternalName",     "Remastra"
      VALUE "OriginalFilename", "Remastra.exe"
      VALUE "ProductName",      "REMASTRA"
      VALUE "ProductVersion",   "1.5.5"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
